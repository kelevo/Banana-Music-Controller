{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "banana-music-controller",
  "version": "0.1.0",
  "identifier": "com.patrick.banana-music-controller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "banana-music-controller",
        "width": 330,
        "height": 86,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "copyright": "Copyright © 2026 Patrick J. Hernandez",
    "publisher": "Patrick J. Hernandez",
    "shortDescription": "Controlador multimedia flotante para Windows 11",
    "longDescription": "Banana Music Controller - Desarrollado por Patrick J. Hernandez",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
